## 4. Fonctions RPC ACTUELLES du Backend

### `fn_upsert_couple_profile` - Création/Mise à jour profil

```sql
CREATE OR REPLACE FUNCTION public.fn_upsert_couple_profile(
  p_user_id uuid, 
  p_user_firstname text, 
  p_user_birthdate date, 
  p_user_gender text DEFAULT 'non_precise'::text,    -- TEXT, sera casté en enum
  p_partner_firstname text DEFAULT NULL::text, 
  p_partner_birthdate date DEFAULT NULL::date, 
  p_partner_gender text DEFAULT 'non_precise'::text  -- TEXT, sera casté en enum
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public'
AS $$
DECLARE v_profile_id uuid;
BEGIN
  INSERT INTO couple_profiles (...)
  VALUES (
    ...
    p_user_gender::sexe_personne,      -- CAST obligatoire !
    ...
    p_partner_gender::sexe_personne    -- CAST obligatoire !
  )
  ON CONFLICT (user_id) DO UPDATE SET ...
  RETURNING id INTO v_profile_id;
  
  RETURN jsonb_build_object('success', true, 'profile_id', v_profile_id, 'user_id', p_user_id);
END;
$$;
```

### `fn_get_couple_profile_id` - Récupération ID profil (bypass RLS)

```sql
CREATE OR REPLACE FUNCTION public.fn_get_couple_profile_id(p_user_id uuid)
RETURNS uuid
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public'
AS $$
DECLARE v_profile_id uuid;
BEGIN
  SELECT id INTO v_profile_id
  FROM couple_profiles
  WHERE user_id = p_user_id
  LIMIT 1;
  
  RETURN v_profile_id;
END;
$$;

GRANT EXECUTE ON FUNCTION public.fn_get_couple_profile_id TO authenticated;
GRANT EXECUTE ON FUNCTION public.fn_get_couple_profile_id TO anon;
```

