## 8. Requêtes de Diagnostic Backend

```sql
-- 1. Voir les colonnes d'une table
SELECT column_name, data_type, is_nullable 
FROM information_schema.columns 
WHERE table_name = 'couple_profiles'
ORDER BY ordinal_position;

-- 2. Voir tous les enums
SELECT t.typname AS enum_name, 
       array_agg(e.enumlabel ORDER BY e.enumsortorder) AS values
FROM pg_type t
JOIN pg_enum e ON t.oid = e.enumtypid
GROUP BY t.typname;

-- 3. Voir les politiques RLS d'une table
SELECT policyname, cmd, roles 
FROM pg_policies 
WHERE tablename = 'couple_profiles';

-- 4. Voir une fonction RPC
SELECT pg_get_functiondef(oid) AS function_definition
FROM pg_proc 
WHERE proname = 'fn_upsert_couple_profile';

-- 5. Vérifier les profils récents
SELECT id, user_id, user_firstname, created_at 
FROM couple_profiles 
ORDER BY created_at DESC LIMIT 5;

-- 6. Vérifier les utilisateurs auth.users
SELECT id, email, created_at 
FROM auth.users 
ORDER BY created_at DESC LIMIT 5;
```

