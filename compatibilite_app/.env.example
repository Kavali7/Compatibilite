# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Kkiapay Payment Configuration
# Get your API keys from https://app.kkiapay.me
KKIAPAY_PUBLIC_KEY=your-kkiapay-public-key
# Set to 'false' for live/production mode, 'true' for sandbox/test mode
# IMPORTANT: Use the corresponding API key (sandbox key for sandbox, live key for live)
KKIAPAY_SANDBOX=true

# Admin Configuration
ADMIN_PASSWORD=admin123
